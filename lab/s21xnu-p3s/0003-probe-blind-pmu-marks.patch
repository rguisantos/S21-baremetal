diff --git a/shim/blind.h b/shim/blind.h
new file mode 100644
index 0000000..cfb152b
--- /dev/null
+++ b/shim/blind.h
@@ -0,0 +1,40 @@
+/*
+ * Blind probe for the S21 Ultra: progress marks in PMU INFORM registers,
+ * read back from the S-Boot log on the next boot (show_reset_reason_rawdata
+ * prints inform2/inform3). Needed because the DECON is in command mode and
+ * framebuffer writes may never reach the panel.
+ *
+ * Offsets from the stock p3s FDT (sec-reboot, exynos-reboot) on the HZC2
+ * vendor_boot, same as the Samsung kernel uses from EL1:
+ *   0x808 magic-inform  (INFORM2): we keep bits 31..16 at zero, as after a
+ *                                  manual reset, and put 0x51nn in 15..0
+ *   0x80c panic-inform  (INFORM3): 0x12345604 = SEC_RESET_REASON_RECOVERY
+ *   0x3c00 reboot-offset, trigger 0x2: S/W reset, as exynos-reboot.c
+ * So the next boot lands in the recovery by itself.
+ *
+ * SHIM_BLIND=1: mark and reset at the first instruction (did it run?).
+ * SHIM_BLIND=2: marks at each stage of the probe; reset by PMU at the end
+ *               and on any exception. BLIND_PMU overrides the base (QEMU).
+ * SHIM_BLIND=4: read DECON0 TRIG_CON/GLOBAL_CON into INFORM2 (0x6TTG),
+ *               unmask the hardware trigger and hold red, then green, 15 s
+ *               each, then reset by PMU.
+ * SHIM_BLIND=3: 30 s wait at the assumed counter rate, then PSCI
+ *               SYSTEM_RESET (0x12 before it, 0x13 if it returns).
+ */
+#ifndef SHIM_BLIND
+#define SHIM_BLIND 0
+#endif
+#ifndef BLIND_PMU
+#define BLIND_PMU 0x15860000
+#endif
+#define BLIND_INFORM2	(BLIND_PMU + 0x808)
+#define BLIND_INFORM3	(BLIND_PMU + 0x80c)
+#define BLIND_SWRESET	(BLIND_PMU + 0x3c00)
+#define BLIND_RECOVERY	0x12345604
+#ifndef BLIND_DECON
+#define BLIND_DECON	0x19f00000	/* decon_0 in the p3s FDT */
+#endif
+#define DECON0_GLOBAL_CON	(BLIND_DECON + 0x20)
+#define DECON0_TRIG_CON		(BLIND_DECON + 0x30)
+#define DECON0_SHD_UP		(BLIND_DECON + 0x50)
+#define BLIND_TAG	0x5100
diff --git a/shim/build-s21.sh b/shim/build-s21.sh
index 9a38cde..4a434ea 100755
--- a/shim/build-s21.sh
+++ b/shim/build-s21.sh
@@ -12,7 +12,7 @@ case "$BOARD" in
   p3s-window) BOARD_CFLAGS=-DSWEET_BOARD_P3S_WINDOW ;;
   *) echo "error: unknown BOARD=$BOARD (t2s|p3s|p3s-window)" >&2; exit 1 ;;
 esac
-CFLAGS="$BOARD_CFLAGS -O2 -ffreestanding -nostdlib -fno-pic -mgeneral-regs-only -mstrict-align -fno-stack-protector -Wall -Wextra"
+CFLAGS="$BOARD_CFLAGS -DSHIM_BLIND=${SHIM_BLIND:-0} ${BLIND_PMU:+-DBLIND_PMU=$BLIND_PMU} ${BLIND_DECON:+-DBLIND_DECON=$BLIND_DECON} -O2 -ffreestanding -nostdlib -fno-pic -mgeneral-regs-only -mstrict-align -fno-stack-protector -Wall -Wextra"
 mkdir -p out
 for f in start.S shim.c console.c mmu.c fdt.c loader.c ufs.c; do $CC $CFLAGS -c $f -o out/${f%.*}.o; done
 abs=$(aarch64-linux-gnu-readelf -r out/shim.o out/console.o out/mmu.o out/fdt.o out/loader.o out/ufs.o | grep -c ABS64 || true)
diff --git a/shim/shim.c b/shim/shim.c
index 8d55f1d..d8bd9da 100644
--- a/shim/shim.c
+++ b/shim/shim.c
@@ -12,6 +12,7 @@
 #include "loader.h"
 #include "ufs.h"
 #include "fdt.h"
+#include "blind.h"
 
 /* S21: CNTFRQ_EL0 reads 0 on this firmware; the counter really runs at 26 MHz. */
 #define CNTFRQ			26000000UL
@@ -101,8 +102,35 @@ static void delay_ms(unsigned ms)
 		;
 }
 
+static uint32_t blind_last;
+
+/* SHIM_BLIND=2: progress mark in INFORM2 (bits 15..0), read from the S-Boot log. */
+static void mark(uint32_t code)
+{
+	if (SHIM_BLIND < 2)
+		return;
+	blind_last = code;
+	__asm__ volatile("dsb sy" ::: "memory");
+	wr32(BLIND_INFORM2, BLIND_TAG | code);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void __attribute__((noreturn)) blind_reset(void)
+{
+	wr32(BLIND_INFORM3, BLIND_RECOVERY);
+	__asm__ volatile("dsb sy" ::: "memory");
+	wr32(BLIND_SWRESET, 2);
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (;;)
+		__asm__ volatile("wfe");
+}
+
 static void __attribute__((noreturn)) reset(unsigned after_s)
 {
+	if (SHIM_BLIND >= 2) {
+		mark(0x0f);
+		blind_reset();
+	}
 	con_skip();
 	con_str("RESET", after_s > 20 ? "in 40s" : "in 20s");
 	delay_ms(after_s * 1000);
@@ -140,6 +168,11 @@ void exc_handler(uint64_t slot, uint64_t *regs)
 		irq_handler();
 		return;
 	}
+	if (SHIM_BLIND >= 2) {
+		/* 0x5S8X: exception in vector slot X after stage S */
+		wr32(BLIND_INFORM2, 0x5000 | (blind_last & 0xf) << 8 | 0x80 | (slot & 0xf));
+		blind_reset();
+	}
 	con_clear(BLUE);
 	switch (slot & 3) {
 	case 0: con_str("PANIC", "SYNC"); break;
@@ -373,11 +406,62 @@ void shim_main(uint64_t dtb)
 	struct mmu_info mi;
 
 	/* An xnu payload in the ramdisk means: boot it (MMU stays off). */
+	mark(0x02);
+	if (SHIM_BLIND == 4) {
+		/*
+		 * Display: the DECON0 is in command mode with hardware (TE)
+		 * trigger (psr_mode=2, trig_mode=0 in the p3s FDT). In that mode
+		 * the Samsung driver masks the trigger between frames
+		 * (decon_reg_set_trigger: HW_TRIG_MASK_DECON). Record TRIG_CON and
+		 * GLOBAL_CON as S-Boot left them, unmask the trigger, request a
+		 * shadow update, and hold red then green so the user can see it.
+		 * Registers from cal_2100/regs-decon.h, base from the FDT.
+		 */
+		uint32_t trig = rd32(DECON0_TRIG_CON), glob = rd32(DECON0_GLOBAL_CON);
+		uint32_t code = 0x6000 | (trig & 0x3f) << 6 |
+				((glob >> 8) & 1) | ((glob >> 4) & 1) << 1 |
+				((glob >> 1) & 1) << 2 | (glob & 1) << 3 | ((glob >> 5) & 1) << 4;
+		con_clear(RED);
+		con_str("SHIM", "s21 tela: trigger DECON");
+		con_hex2("TRIG", "con=", trig, "glob=", glob);
+		wr32(DECON0_TRIG_CON, (trig | 1) & ~(1u << 4));	/* HW_TRIG_EN, unmask */
+		wr32(DECON0_SHD_UP, rd32(DECON0_SHD_UP) | (1u << 31));
+		__asm__ volatile("dsb sy" ::: "memory");
+		wr32(BLIND_INFORM2, code);
+		uint64_t t0 = now();
+		while (now() - t0 < CNTFRQ * 15)
+			;
+		con_clear(GREEN);
+		con_str("SHIM", "s21 tela: verde");
+		t0 = now();
+		while (now() - t0 < CNTFRQ * 15)
+			;
+		blind_reset();
+	}
+	if (SHIM_BLIND == 3) {
+		/*
+		 * Clock and PSCI reset, the two differences between the blind run
+		 * (0x510f) and the screen probe that never reset: a 30 s wait at the
+		 * assumed 26 MHz (timed from outside by the USB disconnect/reconnect),
+		 * then PSCI SYSTEM_RESET; if it returns, mark 0x13 and reset by PMU.
+		 */
+		mark(rsr("cntfrq_el0") ? 0x11 : 0x10);
+		uint64_t t0 = now();
+		while (now() - t0 < CNTFRQ * 30)
+			;
+		mark(0x12);
+		__asm__ volatile("dsb sy" ::: "memory");
+		smc(PSCI_SYSTEM_RESET, 0, 0, 0);
+		mark(0x13);
+		blind_reset();
+	}
 	stage = "loader";
 	con_clear(RED);
+	mark(0x03);
 	con_str("SHIM", "s21 stage 1: shim bring-up");
 	con_skip();
 	const char *why = loader_boot(dtb);
+	mark(0x04);
 	con_str("LOADER", why);
 	con_skip();
 	{
@@ -398,11 +482,13 @@ void shim_main(uint64_t dtb)
 		con_hex2("FB", "w=", FB_W, "stride=", FB_STRIDE);
 		con_skip();
 	}
+	mark(0x05);
 	{
 		uint64_t t0 = now();
-		while (now() - t0 < 26000000UL * 25)	/* keep the loader result on screen ~25 s */
+		while (now() - t0 < 26000000UL * (SHIM_BLIND ? 2 : 25))	/* keep the loader result on screen ~25 s */
 			;
 	}
+	mark(0x06);
 
 	stage = "fill off";
 	uint64_t fill_off = ticks_fill(RED);
@@ -410,6 +496,7 @@ void shim_main(uint64_t dtb)
 
 	stage = "mmu enable";
 	int rc = mmu_enable(&mi);
+	mark(rc ? 0x0e : 0x07);
 
 	stage = "fill on";
 	uint64_t fill_on = rc ? 0 : ticks_fill(RED);
@@ -438,9 +525,12 @@ void shim_main(uint64_t dtb)
 	con_skip();
 
 	stage = "psci";
+	mark(0x08);
 	con_hex2("PSCI", "ver=", smc(PSCI_VERSION, 0, 0, 0), "smccc=", smc(SMCCC_VERSION, 0, 0, 0));
 	con_skip();
+	mark(0x09);
 	test_gic();
+	mark(0x0a);
 
 	stage = "done";
 	reset(40);
diff --git a/shim/start.S b/shim/start.S
index e7fa3d7..8b7c582 100644
--- a/shim/start.S
+++ b/shim/start.S
@@ -1,3 +1,4 @@
+#include "blind.h"
 /*
  * sweet boot shim entry: arm64 Linux Image header so Qualcomm ABL treats
  * us like a kernel. ABL enters at EL1, MMU/D-cache off, x0 = DTB pointer.
@@ -20,6 +21,22 @@ _head:
 	.globl _start
 _start:
 	msr	daifset, #0xf
+#if SHIM_BLIND
+	/* first instruction after the hand-off: recovery request + mark 01 */
+	ldr	x9, =BLIND_PMU
+	ldr	w10, =BLIND_RECOVERY
+	str	w10, [x9, #0x80c]
+	mov	w10, #(BLIND_TAG | 0x01)
+	str	w10, [x9, #0x808]
+	dsb	sy
+#if SHIM_BLIND == 1
+	mov	w10, #2
+	str	w10, [x9, #0x3c00]
+	dsb	sy
+5:	wfe
+	b	5b
+#endif
+#endif
 	mov	x19, x0			/* DTB pointer from ABL */
 	msr	spsel, #1
 	adr	x1, _stack_top
@@ -38,6 +55,7 @@ _start:
 	bl	shim_main
 3:	wfe
 	b	3b
+	.ltorg
 
 /* PSCI CPU_ON target. x0 = context id = cpu index (1..7). */
 	.globl secondary_entry
