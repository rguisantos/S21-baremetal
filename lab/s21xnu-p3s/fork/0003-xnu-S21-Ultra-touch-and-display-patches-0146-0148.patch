+diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
+index 5029544..ca4d097 100644
+--- a/iokit/Kernel/arm/hid/SweetHID.cpp
++++ b/iokit/Kernel/arm/hid/SweetHID.cpp
+@@ -359,6 +359,50 @@ OSDefineMetaClassAndStructors(SweetHIDButtons, IOHIDEventService);
+ #define SWEET_TOUCH_EDGE_BOTTOM_PX 100
+ /* sweet-hid field toggles: boot-arg sweethidf, set bit = feature off */
+ static uint32_t sweet_hid_f;
++/*
++ * 0147: touch geometry. Panel = console view (1080x2400 on the S21+ and with
++ * the p3s-window profile, 1440x3200 with the full p3s profile; 1080x2400 if
++ * the console is not set up). The presented display is the iPhone X 1125x2436
++ * unless sweetfb_native=1; it is centered on the panel, so the offset is
++ * positive when it is cropped (S21+) and negative when it is letterboxed.
++ */
++static inline void
++sweet_hid_geometry(int vw, int vh, int native, int *pw, int *ph, int *lw, int *lh, int *ox, int *oy)
++{
++	if (vw <= 0 || vh <= 0 || vw > 8192 || vh > 8192) {
++		vw = 1080;
++		vh = 2400;
++	}
++	*pw = vw;
++	*ph = vh;
++	*lw = vw;
++	*lh = vh;
++	if (!native && ((vw <= 1125 && vh <= 2436) || (vw >= 1125 && vh >= 2436))) {
++		*lw = 1125;
++		*lh = 2436;
++	}
++	*ox = (*lw - vw) / 2;
++	*oy = (*lh - vh) / 2;
++}
++
++/* Panel-pixel bounds of the part of the presented display the panel shows. */
++static inline void
++sweet_hid_visible(int pw, int ph, int lw, int lh, int ox, int oy, int *l, int *r, int *t, int *b)
++{
++	*l = ox < 0 ? -ox : 0;
++	*t = oy < 0 ? -oy : 0;
++	*r = lw - ox - 1 < pw - 1 ? lw - ox - 1 : pw - 1;
++	*b = lh - oy - 1 < ph - 1 ? lh - oy - 1 : ph - 1;
++}
++
++/* Panel pixel -> 16.16 fraction of the presented display, clamped to [0, 1]. */
++static inline IOFixed
++sweet_hid_norm(int v, int off, int logical)
++{
++	int64_t n = ((int64_t)(v + off) << 16) / logical;
++	return (IOFixed)(n < 0 ? 0 : (n > 0x10000 ? 0x10000 : n));
++}
++
+ class SweetHIDTouch : public IOHIDEventService {
+ 	OSDeclareDefaultStructors(SweetHIDTouch);
+ public:
+@@ -370,7 +414,7 @@ protected:
+ 	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 2; }
+ private:
+ 	IOLock *fLock;
+-	int fLogicalW, fLogicalH, fOffX, fOffY;
++	int fLogicalW, fLogicalH, fOffX, fOffY, fPanelW, fPanelH;
+ 	bool fDown[SWEET_TOUCH_FINGERS];
+ 	bool fEdge[SWEET_TOUCH_FINGERS];
+ 	IOFixed fX[SWEET_TOUCH_FINGERS];
+@@ -437,10 +481,12 @@ SweetHIDTouch::start(IOService *provider)
+ 	}
+ 	int native = 0;
+ 	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
+-	fLogicalW = native ? 1080 : 1125;
+-	fLogicalH = native ? 2400 : 2436;
+-	fOffX = (fLogicalW - 1080) / 2;
+-	fOffY = (fLogicalH - 2400) / 2;
++	/* 0147: same geometry rule as SweetFramebuffer.cpp, from the console view. */
++	PE_Video video;
++	bzero(&video, sizeof(video));
++	PE_current_console(&video);
++	sweet_hid_geometry((int)video.v_width, (int)video.v_height, native,
++	    &fPanelW, &fPanelH, &fLogicalW, &fLogicalH, &fOffX, &fOffY);
+ 	/* The digitizer covers the main display (backboardd maps it 1:1). */
+ 	setProperty("DisplayIntegrated", kOSBooleanTrue);
+ 	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 */
+@@ -462,14 +508,14 @@ SweetHIDTouch::touch(int finger, bool down, int x, int y)
+ 	if (finger < 0 || finger >= SWEET_TOUCH_FINGERS) {
+ 		return;
+ 	}
+-	x = x < 0 ? 0 : (x > 1079 ? 1079 : x);
+-	y = y < 0 ? 0 : (y > 2399 ? 2399 : y);
++	x = x < 0 ? 0 : (x > fPanelW - 1 ? fPanelW - 1 : x);
++	y = y < 0 ? 0 : (y > fPanelH - 1 ? fPanelH - 1 : y);
+ 
+ 	IOLockLock(fLock);
+ 	bool was = fDown[finger];
+ 	/* Panel pixels -> the presented 1125x2436 display (SweetFramebuffer.cpp). */
+-	IOFixed nx = (IOFixed)(((int64_t)(x + fOffX) << 16) / fLogicalW);
+-	IOFixed ny = (IOFixed)(((int64_t)(y + fOffY) << 16) / fLogicalH);
++	IOFixed nx = sweet_hid_norm(x, fOffX, fLogicalW);
++	IOFixed ny = sweet_hid_norm(y, fOffY, fLogicalH);
+ 	static const char sweet_first_fix[] __attribute__((used)) = "sweet-hid clean first sample";
+ 	bool moved = down && was && (nx != fX[finger] || ny != fY[finger]);
+ 	if (was == down && !moved) {
+@@ -477,8 +523,11 @@ SweetHIDTouch::touch(int finger, bool down, int x, int y)
+ 		return;
+ 	}
+ 	if (!was && down) {
+-		fEdge[finger] = x < SWEET_TOUCH_EDGE_PX || x > 1079 - SWEET_TOUCH_EDGE_PX ||
+-		    y < SWEET_TOUCH_EDGE_PX || y > 2399 - SWEET_TOUCH_EDGE_BOTTOM_PX;
++		/* 0147: edges of the visible part of the presented display, panel pixels */
++		int l, r, t, b;
++		sweet_hid_visible(fPanelW, fPanelH, fLogicalW, fLogicalH, fOffX, fOffY, &l, &r, &t, &b);
++		fEdge[finger] = x < l + SWEET_TOUCH_EDGE_PX || x > r - SWEET_TOUCH_EDGE_PX ||
++		    y < t + SWEET_TOUCH_EDGE_PX || y > b - SWEET_TOUCH_EDGE_BOTTOM_PX;
+ 	}
+ 
+ 	collection = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
diff --git a/xnu/patches/0148-s21-p3s-scaled-display.patch b/xnu/patches/0148-s21-p3s-scaled-display.patch
new file mode 100644
index 0000000..b0869b9
--- /dev/null
+++ b/xnu/patches/0148-s21-p3s-scaled-display.patch
@@ -0,0 +1,195 @@
+diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
+index c18581b..a8e2c46 100644
+--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
++++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
+@@ -132,6 +132,7 @@ enum {
+  * Boot-arg sweetfb_native=1 presents the real panel size instead.
+  * 0147: a larger panel (S21 Ultra, 1440x3200) shows the whole 1125x2436
+  * display centered, 1:1, with black borders (negative fOffX/fOffY).
++ * 0148: with sweetfb_scale=1 it is scaled to the panel width instead.
+  */
+ #define SWEET_FB_LOGICAL_W              1125
+ #define SWEET_FB_LOGICAL_H              2436
+@@ -145,6 +146,65 @@ OSDefineMetaClassAndStructors(IOMobileFramebuffer, IOService);
+ 
+ class IOMobileFramebufferUserClient;
+ 
++/*
++ * 0148: boot-arg sweetfb_scale=1 on a panel larger than the presented display
++ * (S21 Ultra 1440x3200) scales the iPhone X 1125x2436 to the panel width,
++ * 1440x3118, centered (41 rows of border top and bottom), nearest neighbour on
++ * the CPU. SweetHID.cpp uses the same fit for touch.
++ */
++static inline void
++sweet_present_fit(int32_t pw, int32_t ph, int32_t lw, int32_t lh, int32_t *dw, int32_t *dh)
++{
++	if ((int64_t)lh * pw / lw <= ph) {
++		*dw = pw;
++		*dh = (int32_t)((int64_t)lh * pw / lw);
++	} else {
++		*dh = ph;
++		*dw = (int32_t)((int64_t)lw * ph / lh);
++	}
++}
++
++/*
++ * Copy the logical rect (dx,dy,w,h) of a BGRA surface, whose (sx,sy) is its
++ * top-left, to the panel, scaled into the presented rect (px,py,pw2,ph2) of a
++ * lw x lh logical display. Every panel pixel takes the source pixel whose
++ * logical position contains it. Returns the number of panel rows written.
++ */
++static int32_t
++sweet_fb_scaled_blit(const uint8_t *src, uint64_t src_len, uint32_t src_bpr, int32_t sx, int32_t sy,
++    int32_t dx, int32_t dy, int32_t w, int32_t h, uint8_t *panel, uint32_t rowbytes, int32_t pw, int32_t ph,
++    int32_t px, int32_t py, int32_t pw2, int32_t ph2, int32_t lw, int32_t lh)
++{
++	if (w <= 0 || h <= 0 || sx < 0 || sy < 0 || pw2 <= 0 || ph2 <= 0 || lw <= 0 || lh <= 0) {
++		return 0;
++	}
++	/* panel pixel X samples logical floor((X - px) * lw / pw2): the rect covers
++	   exactly the X in [px + ceil(dx * pw2 / lw), px + ceil((dx + w) * pw2 / lw)) */
++	int32_t x0 = px + (int32_t)(((int64_t)dx * pw2 + lw - 1) / lw), x1 = px + (int32_t)(((int64_t)(dx + w) * pw2 + lw - 1) / lw);
++	int32_t y0 = py + (int32_t)(((int64_t)dy * ph2 + lh - 1) / lh), y1 = py + (int32_t)(((int64_t)(dy + h) * ph2 + lh - 1) / lh);
++	x0 = x0 < 0 ? 0 : x0;
++	y0 = y0 < 0 ? 0 : y0;
++	x1 = x1 > pw ? pw : x1;
++	y1 = y1 > ph ? ph : y1;
++	int32_t rows = 0;
++	for (int32_t Y = y0; Y < y1; Y++) {
++		int32_t ly = (int32_t)((int64_t)(Y - py) * lh / ph2) - dy;
++		ly = ly < 0 ? 0 : (ly >= h ? h - 1 : ly);
++		uint64_t row = (uint64_t)(sy + ly) * src_bpr;
++		uint8_t *out = panel + (uint64_t)Y * rowbytes;
++		for (int32_t X = x0; X < x1; X++) {
++			int32_t lx = (int32_t)((int64_t)(X - px) * lw / pw2) - dx;
++			lx = lx < 0 ? 0 : (lx >= w ? w - 1 : lx);
++			uint64_t at = row + (uint64_t)(sx + lx) * 4;
++			if (at + 4 <= src_len) {
++				__builtin_memcpy(out + (uint64_t)X * 4, src + at, 4); /* no -Wcast-align */
++			}
++		}
++		rows++;
++	}
++	return rows;
++}
++
+ class AppleCLCD : public IOMobileFramebuffer {
+ 	OSDeclareDefaultStructors(AppleCLCD);
+ 
+@@ -162,6 +222,8 @@ public:
+ 	uint32_t      fWidth, fHeight, fRowBytes;
+ 	uint32_t      fLogicalW, fLogicalH;     /* size reported to userland */
+ 	int32_t       fOffX, fOffY;             /* logical origin of the panel */
++	bool          fScaled;                  /* 0148: sweetfb_scale */
++	int32_t       fPresX, fPresY, fPresW, fPresH; /* presented rect in panel pixels when scaled */
+ 	uintptr_t     fPixels;          /* kernel mapping of the panel memory */
+ 	IOMemoryMap  *fMap;
+ 	SweetSurface *fSurface;         /* the panel memory as an IOSurface */
+@@ -278,6 +340,17 @@ AppleCLCD::start(IOService *provider)
+ 	}
+ 	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
+ 	fOffY = (int32_t)(fLogicalH - fHeight) / 2;
++	int scale = 0;
++	PE_parse_boot_argn("sweetfb_scale", &scale, sizeof(scale));
++	fScaled = scale && !native && fWidth >= SWEET_FB_LOGICAL_W && fHeight >= SWEET_FB_LOGICAL_H;
++	fPresX = fPresY = 0;
++	fPresW = (int32_t)fWidth;
++	fPresH = (int32_t)fHeight;
++	if (fScaled) {
++		sweet_present_fit((int32_t)fWidth, (int32_t)fHeight, (int32_t)fLogicalW, (int32_t)fLogicalH, &fPresW, &fPresH);
++		fPresX = ((int32_t)fWidth - fPresW) / 2;
++		fPresY = ((int32_t)fHeight - fPresH) / 2;
++	}
+ 	fLock = IOLockAlloc();
+ 	fClients = OSArray::withCapacity(4);
+ 	fSurface = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
+@@ -556,6 +629,14 @@ AppleCLCD::sweet_fb_yuv_layer(const uint8_t *rec, uint32_t layer)
+ 	const struct sweet_surface_plane *py = &s->planes[0], *pc = &s->planes[1];
+ 	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4), sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
+ 	int32_t dx = (int32_t)get32(b, 0) - fOffX, dy = (int32_t)get32(b, 4) - fOffY, dw = (int32_t)get32(b, 8), dh = (int32_t)get32(b, 12);
++	if (fScaled) {      /* 0148: logical rect -> presented rect; the loop below already scales sw -> dw */
++		int32_t lx = (int32_t)get32(b, 0), ly = (int32_t)get32(b, 4);
++		int64_t LW = (int64_t)fLogicalW, LH = (int64_t)fLogicalH;   /* ceil, as sweet_fb_scaled_blit */
++		dx = fPresX + (int32_t)(((int64_t)lx * fPresW + LW - 1) / LW);
++		dy = fPresY + (int32_t)(((int64_t)ly * fPresH + LH - 1) / LH);
++		dw = fPresX + (int32_t)(((int64_t)(lx + (int32_t)get32(b, 8)) * fPresW + LW - 1) / LW) - dx;
++		dh = fPresY + (int32_t)(((int64_t)(ly + (int32_t)get32(b, 12)) * fPresH + LH - 1) / LH) - dy;
++	}
+ 	uintptr_t base = s->kernelAddress();
+ 	uint64_t len = s->memory != NULL ? s->memory->getLength() : 0;
+ 	if (sw <= 0 || sh <= 0) {
+@@ -808,6 +889,23 @@ AppleCLCD::present(const uint8_t *rec)
+ 		if (dx < 0 || dy < 0) {
+ 			dx = dy = 0;
+ 		}
++		if (fScaled) {      /* 0148: scaled on the CPU; the Mali blit only copies 1:1 */
++			if (w > (int32_t)s->width - sx) {
++				w = (int32_t)s->width - sx;
++			}
++			if (h > (int32_t)s->height - sy) {
