++		volatile uint8_t *bigger = (volatile uint8_t *)ml_io_map_unmappable(bar2_phys, need, VM_WIMG_IO);
++
++		blog("BAR2 mapped again: %#lx bytes for RAM %#x + %#x: %s", (unsigned long)need, rambase, ramsize,
