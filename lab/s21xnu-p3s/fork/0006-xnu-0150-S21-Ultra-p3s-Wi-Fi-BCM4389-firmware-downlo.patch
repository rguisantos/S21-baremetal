+ static uint32_t ramsize;
++static uint32_t rambase = RAMBASE_4375;  /* 0150 */
++static bool ca7;                         /* 0150: BCM4389, ARM CA7 + SYSMEM */
++static struct core *sysmem;
++static uint32_t bar2_phys;
++static const char *fwp = "bcm4375";      /* 0150: file name prefix in /usr/local/etc/wifi */
+ static uint32_t mb_int, mb_mask, h2d_mb0, h2d_mb1;
+ static uint8_t *pool;                   /* bump allocator over the mapped part of the pool */
+ static size_t pool_used;
+@@ -449,7 +467,7 @@ tcm_w32(uint32_t addr, uint32_t value)
+ static bool
+ in_ram(uint32_t addr, uint32_t len)
+ {
+-	return addr >= RAMBASE_4375 && addr + len >= addr && addr + len <= RAMBASE_4375 + ramsize && addr + len <= tcm_size;
++	return addr >= rambase && addr + len >= addr && addr + len <= rambase + ramsize && addr + len <= tcm_size;
+ }
+ 
+ static void *
+@@ -668,6 +686,68 @@ cr4_active(uint32_t rstvec)
+ 	core_reset(cr4, ARMCR4_CPUHALT, 0, 0);
+ }
+ 
++/* 0150: SYSMEM coreinfo: ROM and RAM bank counts, by the core's revision (si_sysmem_size(), include/sbsysmem.h) */
++static inline void
++sysmem_banks(uint32_t info, unsigned rev, uint32_t *nrb, uint32_t *nb)
++{
++	if (rev < 12) {
++		*nrb = (info >> 5) & 0x1f;
++		*nb = info & 0x1f;
++	} else {
++		*nrb = (info >> 24) & 0xff;
++		*nb = (info >> 16) & 0xff;
++	}
++}
++
++/* 0150: si_sysmem_size() (bcmdhd siutils.c): RAM banks after the ROM banks, 8 KB units */
++static uint32_t
++sysmem_ramsize(void)
++{
++	uint32_t info, nrb, nb, size = 0;
++
++	if ((bp_read(sysmem->wrap + BCMA_RESET_CTL) & BCMA_RESET_CTL_RESET) ||
++	    (bp_read(sysmem->wrap + BCMA_IOCTL) & (BCMA_IOCTL_FGC | BCMA_IOCTL_CLK)) != BCMA_IOCTL_CLK) {
++		core_reset(sysmem, 0, 0, 0);
++	}
++	info = bp_read(sysmem->base + SYSMEM_COREINFO);
++	if (info == 0xffffffffU) {
++		return 0;
++	}
++	sysmem_banks(info, sysmem->rev, &nrb, &nb);
++	for (uint32_t i = 0; i < nb; i++) {
++		bp_write(sysmem->base + SYSMEM_BANKIDX, i + nrb);
++		delay(1);
++		size += ((bp_read(sysmem->base + SYSMEM_BANKINFO) & 0x7f) + 1) * 8192;
++	}
++	blog("SYSMEM rev %u coreinfo %#x: %u ROM banks, %u RAM banks, RAM %#x", sysmem->rev, info, nrb, nb, size);
++	return size;
++}
++
++/* 0150: dhdpcie_bus_download_state(enter) for the CA7: ARM halted and out of reset, SYSMEM reset */
++static void
++ca7_passive(void)
++{
++	w32(cfg, 0x84, 0);      /* dhdpcie_setbar1win(bus, 0): BAR2 (bcmdhd's BAR1) from backplane address 0 */
++	core_reset(cr4, ARMCR4_CPUHALT, ARMCR4_CPUHALT, ARMCR4_CPUHALT);
++	core_reset(sysmem, 0, 0, 0);
++}
++
++/* 0150: dhdpcie_bus_download_state(exit) for the CA7: address 0 must not read all ones (a secured vector) */
++static bool
++ca7_active(uint32_t rstvec)
++{
++	uint32_t was = tcm_r32(0);
++
++	if (was == 0xffffffffU) {
++		blog("W4 FAIL: address 0 reads %#x: the reset vector is secured (a signature would be needed)", was);
++		return false;
++	}
++	tcm_w32(0, rstvec);
++	blog("reset vector: address 0 read %#x, now %#x", was, tcm_r32(0));
++	core_reset(cr4, ARMCR4_CPUHALT, 0, 0);
++	return true;
++}
++
