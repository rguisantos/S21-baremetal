++
++/*
++ * 0150 (S21 Ultra p3s): the BCM4389 C1. Samsung's bcmdhd_101_18 (the HZC2 driver): an ARM CA7 core, its RAM in a
++ * SYSMEM core at CA7_4389_RAM_BASE (include/sbchipc.h), sized by si_sysmem_size() (siutils.c); download state as
++ * dhdpcie_bus_download_state() (dhd_pcie.c): CA7 halted and out of reset, SYSMEM reset, firmware, NVRAM, the
++ * 0xfeedc0de seed, the reset vector at address 0 (unless it reads all ones: a secured vector), CA7 released.
++ */
++#define CORE_ARM_CA7            0x847           /* ARMCA7_CORE_ID, include/hndsoc.h */
++#define CORE_SYSMEM             0x849           /* SYSMEM_CORE_ID */
++#define RAMBASE_4389            0x200000        /* CA7_4389_RAM_BASE */
++#define SYSMEM_COREINFO         0x00            /* include/sbsysmem.h */
++#define SYSMEM_BANKIDX          0x10
++#define SYSMEM_BANKINFO         0x40
+ #define RAMSIZE_MAGIC           0x534d4152      /* "SMAR" at 0x6c of the image: the RAM it was built for [pcie]288 */
+ #define RAMSIZE_OFFSET          0x6c
+ 
+@@ -261,8 +274,13 @@ static uint32_t tcm_size;               /* how much of BAR2 is mapped */
+ static uint32_t win = ~0U;
+ static struct core cores[48];
