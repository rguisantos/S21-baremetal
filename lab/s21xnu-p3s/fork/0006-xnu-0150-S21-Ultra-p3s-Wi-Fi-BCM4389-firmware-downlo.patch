++		if (bigger != NULL) {
++			tcm = bigger;
++			tcm_size = (uint32_t)need;
++		}
++	}
++	if (ramsize == 0 || (!ca7 && rambase + ramsize > tcm_size)) {
++		blog("W4 FAIL: RAM %#x + %#x is not within BAR2's %#x", rambase, ramsize, tcm_size);
+ 		return false;
+ 	}
++	if (ca7 && rambase + ramsize > tcm_size) {
++		/* the image may say less ("SMAR"): firmware() checks again once it has read it */
++		blog("RAM %#x + %#x passes BAR2's %#x: left to the image's own RAM size", rambase, ramsize, tcm_size);
