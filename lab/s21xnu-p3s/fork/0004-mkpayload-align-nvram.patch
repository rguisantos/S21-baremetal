From 18b9b550644e9dd0470cf0bd517b5e7e9fa9697f Mon Sep 17 00:00:00 2001
From: Codex <codex@users.noreply.github.com>
Date: Thu, 26 Nov 2026 17:14:50 -0400
Subject: [PATCH] mkpayload: align Broadcom NVRAM list before writing the word
 count

---
 tools/mkpayload.py            |  7 +++++--
 tools/test_mkpayload_nvram.py | 28 ++++++++++++++++++++++++++++
 2 files changed, 33 insertions(+), 2 deletions(-)
 create mode 100644 tools/test_mkpayload_nvram.py

diff --git a/tools/mkpayload.py b/tools/mkpayload.py
index 53842e3..fac039e 100644
--- a/tools/mkpayload.py
+++ b/tools/mkpayload.py
@@ -161,9 +161,12 @@ def brcmf_nvram(raw):
         raise ValueError('NVRAM file has no key/value entries')
     if not any(x.startswith(b'boardrev=') for x in entries):
         entries.append(b'boardrev=0xff')
-    body = b'\0'.join(entries) + b'\0'
-    body += b'\0' * ((-(len(body) + 1)) & 3)
+    # Each entry has a NUL terminator and one extra NUL ends the list.
+    body = b'\0'.join(entries) + b'\0\0'
+    body += b'\0' * (-len(body) % 4)
     words = len(body) // 4
+    if words > 0xffff:
+        raise ValueError('NVRAM exceeds the 16-bit word count in the length token')
     return body + struct.pack('<I', (((~words) & 0xffff) << 16) | words)
 
 
diff --git a/tools/test_mkpayload_nvram.py b/tools/test_mkpayload_nvram.py
new file mode 100644
index 0000000..cac8c9f
--- /dev/null
+++ b/tools/test_mkpayload_nvram.py
@@ -0,0 +1,28 @@
+import struct
+import unittest
+
+from mkpayload import brcmf_nvram
+
+
+class NvramLayout(unittest.TestCase):
+    def test_all_four_lengths(self):
+        for count in range(4):
+            with self.subTest(count=count):
+                value = b'x' * count
+                nvram = brcmf_nvram(b'# ignored\nboardrev=1\nkey=' + value + b'\n')
+                entries = b'boardrev=1\0key=' + value + b'\0'
+                body, trailer = nvram[:-4], nvram[-4:]
+                self.assertTrue(body.startswith(entries))
+                self.assertIn(body[len(entries):], [bytes(n) for n in range(1, 5)])
+                self.assertEqual(len(body) % 4, 0)
+                words, inverse = struct.unpack('<HH', trailer)
+                self.assertEqual(words * 4, len(body))
+                self.assertEqual(words ^ inverse, 0xffff)
+
+    def test_word_count_overflow(self):
+        with self.assertRaisesRegex(ValueError, 'length token'):
+            brcmf_nvram(b'key=' + b'x' * (4 * 65535))
+
+
+if __name__ == '__main__':
+    unittest.main()
