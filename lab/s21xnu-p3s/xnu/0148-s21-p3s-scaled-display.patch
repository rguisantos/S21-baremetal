+	if (fScaled) {
+		sweet_present_fit((int32_t)fWidth, (int32_t)fHeight, (int32_t)fLogicalW, (int32_t)fLogicalH, &fPresW, &fPresH);
+		fPresX = ((int32_t)fWidth - fPresW) / 2;
+		fPresY = ((int32_t)fHeight - fPresH) / 2;
+	}
 	fLock = IOLockAlloc();
 	fClients = OSArray::withCapacity(4);
 	fSurface = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
@@ -556,6 +629,14 @@ AppleCLCD::sweet_fb_yuv_layer(const uint8_t *rec, uint32_t layer)
 	const struct sweet_surface_plane *py = &s->planes[0], *pc = &s->planes[1];
 	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4), sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
 	int32_t dx = (int32_t)get32(b, 0) - fOffX, dy = (int32_t)get32(b, 4) - fOffY, dw = (int32_t)get32(b, 8), dh = (int32_t)get32(b, 12);
+	if (fScaled) {      /* 0148: logical rect -> presented rect; the loop below already scales sw -> dw */
+		int32_t lx = (int32_t)get32(b, 0), ly = (int32_t)get32(b, 4);
+		int64_t LW = (int64_t)fLogicalW, LH = (int64_t)fLogicalH;   /* ceil, as sweet_fb_scaled_blit */
+		dx = fPresX + (int32_t)(((int64_t)lx * fPresW + LW - 1) / LW);
+		dy = fPresY + (int32_t)(((int64_t)ly * fPresH + LH - 1) / LH);
+		dw = fPresX + (int32_t)(((int64_t)(lx + (int32_t)get32(b, 8)) * fPresW + LW - 1) / LW) - dx;
+		dh = fPresY + (int32_t)(((int64_t)(ly + (int32_t)get32(b, 12)) * fPresH + LH - 1) / LH) - dy;
+	}
 	uintptr_t base = s->kernelAddress();
 	uint64_t len = s->memory != NULL ? s->memory->getLength() : 0;
 	if (sw <= 0 || sh <= 0) {
@@ -808,6 +889,23 @@ AppleCLCD::present(const uint8_t *rec)
 		if (dx < 0 || dy < 0) {
 			dx = dy = 0;
 		}
+		if (fScaled) {      /* 0148: scaled on the CPU; the Mali blit only copies 1:1 */
+			if (w > (int32_t)s->width - sx) {
+				w = (int32_t)s->width - sx;
+			}
+			if (h > (int32_t)s->height - sy) {
+				h = (int32_t)s->height - sy;
+			}
+			if (src != 0 && bpe == 4 && s->elementWidth == 1 && s->elementHeight == 1 && s->memory != NULL &&
+			    s->memory->getLength() > s->offset &&
+			    sweet_fb_scaled_blit((const uint8_t *)src + s->offset, s->memory->getLength() - s->offset,
+			    s->bytesPerRow, sx, sy, dx, dy, w, h, (uint8_t *)fPixels, fRowBytes, (int32_t)fWidth,
+			    (int32_t)fHeight, fPresX, fPresY, fPresW, fPresH, (int32_t)fLogicalW, (int32_t)fLogicalH) > 0) {
+				cpu_layers++;
+			}
+			s->release();
+			continue;
+		}
 		/* Logical (presented) display coordinates -> panel coordinates. */
 		dx -= fOffX;
 		dy -= fOffY;
