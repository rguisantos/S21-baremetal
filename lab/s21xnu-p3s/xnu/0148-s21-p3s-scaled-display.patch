 class IOMobileFramebufferUserClient;
 
+/*
+ * 0148: boot-arg sweetfb_scale=1 on a panel larger than the presented display
+ * (S21 Ultra 1440x3200) scales the iPhone X 1125x2436 to the panel width,
+ * 1440x3118, centered (41 rows of border top and bottom), nearest neighbour on
+ * the CPU. SweetHID.cpp uses the same fit for touch.
+ */
+static inline void
+sweet_present_fit(int32_t pw, int32_t ph, int32_t lw, int32_t lh, int32_t *dw, int32_t *dh)
+{
+	if ((int64_t)lh * pw / lw <= ph) {
+		*dw = pw;
+		*dh = (int32_t)((int64_t)lh * pw / lw);
+	} else {
+		*dh = ph;
+		*dw = (int32_t)((int64_t)lw * ph / lh);
+	}
+}
+
+/*
+ * Copy the logical rect (dx,dy,w,h) of a BGRA surface, whose (sx,sy) is its
+ * top-left, to the panel, scaled into the presented rect (px,py,pw2,ph2) of a
+ * lw x lh logical display. Every panel pixel takes the source pixel whose
+ * logical position contains it. Returns the number of panel rows written.
+ */
+static int32_t
+sweet_fb_scaled_blit(const uint8_t *src, uint64_t src_len, uint32_t src_bpr, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h, uint8_t *panel, uint32_t rowbytes, int32_t pw, int32_t ph,
+    int32_t px, int32_t py, int32_t pw2, int32_t ph2, int32_t lw, int32_t lh)
+{
+	if (w <= 0 || h <= 0 || sx < 0 || sy < 0 || pw2 <= 0 || ph2 <= 0 || lw <= 0 || lh <= 0) {
+		return 0;
+	}
+	/* panel pixel X samples logical floor((X - px) * lw / pw2): the rect covers
+	   exactly the X in [px + ceil(dx * pw2 / lw), px + ceil((dx + w) * pw2 / lw)) */
+	int32_t x0 = px + (int32_t)(((int64_t)dx * pw2 + lw - 1) / lw), x1 = px + (int32_t)(((int64_t)(dx + w) * pw2 + lw - 1) / lw);
+	int32_t y0 = py + (int32_t)(((int64_t)dy * ph2 + lh - 1) / lh), y1 = py + (int32_t)(((int64_t)(dy + h) * ph2 + lh - 1) / lh);
+	x0 = x0 < 0 ? 0 : x0;
+	y0 = y0 < 0 ? 0 : y0;
+	x1 = x1 > pw ? pw : x1;
+	y1 = y1 > ph ? ph : y1;
+	int32_t rows = 0;
+	for (int32_t Y = y0; Y < y1; Y++) {
+		int32_t ly = (int32_t)((int64_t)(Y - py) * lh / ph2) - dy;
+		ly = ly < 0 ? 0 : (ly >= h ? h - 1 : ly);
+		uint64_t row = (uint64_t)(sy + ly) * src_bpr;
+		uint8_t *out = panel + (uint64_t)Y * rowbytes;
+		for (int32_t X = x0; X < x1; X++) {
+			int32_t lx = (int32_t)((int64_t)(X - px) * lw / pw2) - dx;
+			lx = lx < 0 ? 0 : (lx >= w ? w - 1 : lx);
+			uint64_t at = row + (uint64_t)(sx + lx) * 4;
+			if (at + 4 <= src_len) {
+				__builtin_memcpy(out + (uint64_t)X * 4, src + at, 4); /* no -Wcast-align */
+			}
+		}
+		rows++;
+	}
+	return rows;
+}
+
