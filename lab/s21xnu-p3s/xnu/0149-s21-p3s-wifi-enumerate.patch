 static uint32_t wifi_level;
 
+/* 0149: the BCM4389's ChipCommon through BAR0 (window 0x80 at the backplane enumeration base 0x18000000), read only */
+static void
+bcm4389_chipid(void)
+{
+	volatile uint8_t *m;
+	uint32_t cid;
+	wr(cfgw, 0x10, PA_MEM);
+	if (bus.bar0_wide) {
+		wr(cfgw, 0x14, 0);
+	}
+	wr(cfgw, 0x80, 0x18000000U);
+	rmw(cfgw, 0x04, 0, 1U << 1);               /* memory space */
+	m = mapr(PA_MEM, 0x1000);
+	if (!m) {
+		wlog("W2b FAIL: BAR0 map");
+		return;
+	}
+	cid = rd(m, 0);
+	wlog("W2b %s: chipid %08x chip %x rev %u (want chip 4389)", sweet_wifi_chip(cid) == 0x4389 ? "PASS" : "FAIL", cid,
+	    sweet_wifi_chip(cid), sweet_wifi_chiprev(cid));
+}
