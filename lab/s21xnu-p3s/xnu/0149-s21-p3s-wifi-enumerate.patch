 void redwood_bcm4375_run(const struct redwood_bcm_bus *bus);
 
+/* 0149 (S21 Ultra p3s): which radio answered on PCIe channel 0. The p3s carries a BCM4389 (Samsung bcmdhd_101_18
+ * include/bcmdevs.h: BCM4389_D11AX_ID 0x4441, chip 0x4389); redwood_bcm4375.c only knows the BCM4375, so on the p3s
+ * the chip is identified and left alone. Pure functions: host-tested by S21-baremetal's verifier. */
+enum sweet_wifi_radio { SWEET_WIFI_NONE = 0, SWEET_WIFI_BCM4375 = 1, SWEET_WIFI_BCM4389 = 2 };
+static inline enum sweet_wifi_radio
+sweet_wifi_radio(uint32_t id)
+{
+	switch (id) {
+	case 0x447514e4U:
+		return SWEET_WIFI_BCM4375;   /* o1s, t2s */
+	case 0x444114e4U:
+		return SWEET_WIFI_BCM4389;   /* p3s */
+	default:
+		return SWEET_WIFI_NONE;
+	}
+}
+/* ChipCommon chipid register: chip number in bits 0-15, revision in bits 16-19 */
+static inline uint32_t
+sweet_wifi_chip(uint32_t chipid)
+{
+	return chipid & 0xffffU;
+}
+static inline uint32_t
+sweet_wifi_chiprev(uint32_t chipid)
+{
+	return (chipid >> 16) & 0xfU;
+}
