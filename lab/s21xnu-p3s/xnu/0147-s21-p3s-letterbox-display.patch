 #define SWEET_TOUCH_EDGE_BOTTOM_PX 100
 /* sweet-hid field toggles: boot-arg sweethidf, set bit = feature off */
 static uint32_t sweet_hid_f;
+/*
+ * 0147: touch geometry. Panel = console view (1080x2400 on the S21+ and with
+ * the p3s-window profile, 1440x3200 with the full p3s profile; 1080x2400 if
+ * the console is not set up). The presented display is the iPhone X 1125x2436
+ * unless sweetfb_native=1; it is centered on the panel, so the offset is
+ * positive when it is cropped (S21+) and negative when it is letterboxed.
+ */
+static inline void
+sweet_hid_geometry(int vw, int vh, int native, int *pw, int *ph, int *lw, int *lh, int *ox, int *oy)
+{
+	if (vw <= 0 || vh <= 0 || vw > 8192 || vh > 8192) {
+		vw = 1080;
+		vh = 2400;
+	}
+	*pw = vw;
+	*ph = vh;
+	*lw = vw;
+	*lh = vh;
+	if (!native && ((vw <= 1125 && vh <= 2436) || (vw >= 1125 && vh >= 2436))) {
+		*lw = 1125;
+		*lh = 2436;
+	}
+	*ox = (*lw - vw) / 2;
+	*oy = (*lh - vh) / 2;
+}
+
+/* Panel-pixel bounds of the part of the presented display the panel shows. */
+static inline void
+sweet_hid_visible(int pw, int ph, int lw, int lh, int ox, int oy, int *l, int *r, int *t, int *b)
+{
+	*l = ox < 0 ? -ox : 0;
+	*t = oy < 0 ? -oy : 0;
+	*r = lw - ox - 1 < pw - 1 ? lw - ox - 1 : pw - 1;
+	*b = lh - oy - 1 < ph - 1 ? lh - oy - 1 : ph - 1;
+}
+
+/* Panel pixel -> 16.16 fraction of the presented display, clamped to [0, 1]. */
+static inline IOFixed
+sweet_hid_norm(int v, int off, int logical)
+{
+	int64_t n = ((int64_t)(v + off) << 16) / logical;
+	return (IOFixed)(n < 0 ? 0 : (n > 0x10000 ? 0x10000 : n));
+}
