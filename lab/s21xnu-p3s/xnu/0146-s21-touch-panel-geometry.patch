diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 8684a2e..9556353 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -47,6 +47,8 @@
  *                    4096x4096 raw space per nTX:18/nRX:40, rX/rY:4095 from
  *                    the live sec_input probe log)
  *   touch_trace=1    print every decoded event
+ *   touch_panel_w/h  physical panel in pixels (default 1080/2400; S21 Ultra
+ *                    with the p3s-window shim profile: 1440/3200), 0146
  *
  * NOT YET WIRED: posting into whatever SWEET's own HID stand-in expects.
  * I have not seen sweet_keys.c or the real posting entry point on this tree
@@ -407,14 +409,35 @@ extern void sweet_hid_touch(int finger, int down, int x, int y);
 #define S21_PANEL_MAXX 1079
 #define S21_PANEL_MAXY 2399
 
+/*
+ * 0146: raw 0..4095 -> pixel in the 1080x2400 space the HID stand-in expects.
+ * The raw space spans the whole physical panel. On the S21+ (t2s) that panel
+ * is 1080x2400 and the mapping is unchanged. On the S21 Ultra (p3s) the panel
+ * is 1440x3200 and the shim's p3s-window profile shows the 1080x2400 surface
+ * in its top-left corner: boot-args touch_panel_w=1440 touch_panel_h=3200
+ * scale to the physical panel and clamp to the window. Mirroring (touch_flip)
+ * is applied in panel pixels, before the clamp.
+ */
+static uint32_t ts_g_panel_w = 1080, ts_g_panel_h = 2400;
+
+static inline void
+ts_panel_map(uint32_t rx, uint32_t ry, uint32_t flip, uint32_t pw, uint32_t ph, int *ox, int *oy)
+{
+        int x = (int)((rx * pw) >> 12), y = (int)((ry * ph) >> 12);
+        if (flip & 1) { x = (int)pw - 1 - x; }
+        if (flip & 2) { y = (int)ph - 1 - y; }
+        if (x > S21_PANEL_MAXX) { x = S21_PANEL_MAXX; }
+        if (y > S21_PANEL_MAXY) { y = S21_PANEL_MAXY; }
+        *ox = x; *oy = y;
+}
+
 static struct { int down, x, y; } ts_fing[16];   /* fingers posted down (stuck-finger guard, 0139) */
 extern void sweet_gov_touch(void);   /* 0111: touch booster of the load governor */
 static void
 sweet_touch_post(struct ts_touch *t, uint32_t flip)
 {
-        int x = (int)(((uint32_t)t->x * 1080u) >> 12), y = (int)(((uint32_t)t->y * 2400u) >> 12);
-        if (flip & 1) { x = S21_PANEL_MAXX - x; }
-        if (flip & 2) { y = S21_PANEL_MAXY - y; }
+        int x, y;
+        ts_panel_map((uint32_t)t->x, (uint32_t)t->y, flip, ts_g_panel_w, ts_g_panel_h, &x, &y);
         sweet_hid_touch(t->id - 1, t->down ? 1 : 0, x, y);
         if (t->down) {
                 sweet_gov_touch();
@@ -1009,6 +1032,15 @@ sweet_touch_init(void)
 	PE_parse_boot_argn("touch_pwr", &touch_pwr, sizeof(touch_pwr));
 	PE_parse_boot_argn("touch_pull", &touch_pull, sizeof(touch_pull));
 	PE_parse_boot_argn("touch_flip", &touch_flip, sizeof(touch_flip));
+	{
+		uint32_t pw = 0, ph = 0;   /* 0146: physical panel; only full-or-larger panels accepted */
+		if (PE_parse_boot_argn("touch_panel_w", &pw, sizeof(pw)) && pw >= 1080 && pw <= 4096) {
+			ts_g_panel_w = pw;
+		}
+		if (PE_parse_boot_argn("touch_panel_h", &ph, sizeof(ph)) && ph >= 2400 && ph <= 8192) {
+			ts_g_panel_h = ph;
+		}
+	}
 	PE_parse_boot_argn("touch_trace", &touch_trace, sizeof(touch_trace));
 	PE_parse_boot_argn("touch_poll_us", &touch_poll_us, sizeof(touch_poll_us));
 	PE_parse_boot_argn("touch_poll_active_us", &ts_g_active_us, sizeof(ts_g_active_us));
