    "source": "from pathlib import Path\nimport ctypes as c,os,json,select,struct,subprocess,time\nroot=Path('.').resolve();out=root/'build/a0-plan-observed';events=root/'build/a0-plan-observer.jsonl';lib=c.CDLL(None,use_errno=True)\nlib.inotify_init1.argtypes=[c.c_int];lib.inotify_init1.restype=c.c_int;lib.inotify_add_watch.argtypes=[c.c_int,c.c_char_p,c.c_uint];lib.inotify_add_watch.restype=c.c_int\nfd=lib.inotify_init1(os.O_NONBLOCK|os.O_CLOEXEC);assert fd>=0,c.get_errno();watches={};seen=set();mask=0x2|0x4|0x8|0x100\nwith events.open('x') as trace, (root/'build/a0-plan-observed.log').open('x') as log:\n def emit(row):trace.write(json.dumps(row)+'\\n');trace.flush()\n def add(path):\n  if str(path) in seen or not path.exists():return\n  wd=lib.inotify_add_watch(fd,os.fsencode(path),mask)\n  if wd>=0:watches[wd]=path;seen.add(str(path));emit(dict(kind='watch',path=str(path),time_ns=time.time_ns()))\n add(root/'build')\n args=['python3','scripts/check_capture_a0_sizes.py','--stock-dir','build/a0-plan-stock','--candidate-artifacts','/workspace/scratch/1b09503e0552/stage-a0-execution-inputs/S21-HZC2-alinhado-completo-20261102.tar.gz','--source','/workspace/scratch/1b09503e0552/stage-a0-execution-inputs/Kernel.tar.gz','--tools-root','tools/root','--output-dir',str(out)]\n child=subprocess.Popen(args,stdout=log,stderr=subprocess.STDOUT);start=time.monotonic();last=start\n emit(dict(kind='start',observer_pid=os.getpid(),child_pid=child.pid,args=args,time_ns=time.time_ns()))\n while child.poll() is None:\n  if time.monotonic()-start>300:child.kill();raise RuntimeError('observer timeout')\n  add(out);add(out/'candidate')\n  ready,_,_=select.select([fd],[],[],0.2)\n  if ready:\n   data=os.read(fd,65536);pos=0\n   while pos+16<=len(data):\n    wd,bits,cookie,n=struct.unpack_from('iIII',data,pos);name=data[pos+16:pos+16+n].split(b'\\0',1)[0].decode();pos+=16+n\n    if name not in ('dhd.ko','mali_kbase.ko'):continue\n    path=watches[wd]/name;row=dict(kind='event',path=str(pa