  "excerpt": [
    "static ssize_t available_frequencies_show(struct device *d,",
    "\t\t\t\t\t  struct device_attribute *attr,",
    "\t\t\t\t\t  char *buf)",
    "{",
    "\tstruct devfreq *df = to_devfreq(d);",
    "\tssize_t count = 0;",
    "\tint i;",
    "",
    "\tmutex_lock(&df->lock);",
    "",
    "\tfor (i = 0; i < df->profile->max_state; i++)",
    "\t\tcount += scnprintf(&buf[count], (PAGE_SIZE - count - 2),",
    "\t\t\t\t\"%lu \", df->profile->freq_table[i]);",
    "",
    "\tmutex_unlock(&df->lock);"
